{
  "name": "DataCadastro",
  "type": "object",
  "properties": {
    "empreendimento_id": {
      "type": "string",
      "description": "ID do empreendimento relacionado"
    },
    "ordem": {
      "type": "number",
      "description": "Ordem da linha na tabela"
    },
    "documento_id": {
      "type": "string",
      "description": "ID do documento/folha relacionado"
    },
    "datas": {
      "type": "object",
      "description": "Objeto com datas por etapa e revis\u00e3o",
      "additionalProperties": true
    }
  },
  "required": [
    "empreendimento_id",
    "ordem"
  ],
  "rls": {
    "read": {},
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "perfil": "lider"
          }
        },
        {
          "user_condition": {
            "perfil": "coordenador"
          }
        },
        {
          "user_condition": {
            "perfil": "gestao"
          }
        },
        {
          "user_condition": {
            "perfil": "direcao"
          }
        }
      ]
    }
  }
}